{
  "spdx": [
    "SPDX-FileCopyrightText: Copyright (c) 2026 Josh Symonds",
    "SPDX-License-Identifier: Apache-2.0"
  ],
  "template": {
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "agent",
        "openshell.ai/boundary-role": "supervisor"
      },
      "annotations": {
        "example.com/owner": "team-a"
      }
    },
    "spec": {
      "restartPolicy": "Always",
      "dnsPolicy": "ClusterFirst",
      "automountServiceAccountToken": false,
      "hostNetwork": false,
      "securityContext": {
        "runAsUser": 2000,
        "runAsGroup": 2000,
        "runAsNonRoot": true,
        "fsGroup": 2000
      },
      "schedulingGates": [
        {"name": "example.com/template-gate"}
      ],
      "nodeSelector": {
        "kubernetes.io/os": "linux",
        "example.com/pool": "agents"
      },
      "tolerations": [
        {"key": "example.com/dedicated", "operator": "Equal", "value": "agents", "effect": "NoSchedule"}
      ],
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {"key": "example.com/zone", "operator": "In", "values": ["a", "b"]}
                ]
              }
            ]
          }
        }
      },
      "priorityClassName": "agents-high",
      "runtimeClassName": "example-sandbox-runtime",
      "serviceAccountName": "agent-runner",
      "imagePullSecrets": [
        {"name": "example-registry-pull"}
      ],
      "volumes": [
        {"name": "scratch", "emptyDir": {}},
        {"name": "config", "configMap": {"name": "example-config"}},
        {"name": "creds", "secret": {"secretName": "example-secret"}},
        {"name": "data", "persistentVolumeClaim": {"claimName": "example-claim"}}
      ],
      "initContainers": [
        {
          "name": "prepare",
          "image": "registry.example.com/agents/prepare:1",
          "command": ["/bin/sh", "-c", "echo ready > /scratch/ready"],
          "securityContext": {
            "runAsUser": 2000,
            "runAsGroup": 2000,
            "runAsNonRoot": true,
            "allowPrivilegeEscalation": false,
            "capabilities": {"drop": ["ALL"]}
          },
          "volumeMounts": [
            {"name": "scratch", "mountPath": "/scratch"}
          ]
        }
      ],
      "containers": [
        {
          "name": "sandbox",
          "image": "registry.example.com/agents/sandbox:1",
          "imagePullPolicy": "IfNotPresent",
          "command": ["/usr/local/bin/agent"],
          "args": ["--config", "/etc/agent/config.yaml", "--serve"],
          "env": [
            {"name": "OPENSHELL_ENDPOINT", "value": "https://gateway.example.com"},
            {"name": "OPENSHELL_LOG_LEVEL", "value": "info"},
            {"name": "AGENT_MODE", "value": "batch"},
            {"name": "API_TOKEN", "valueFrom": {"secretKeyRef": {"name": "example-secret", "key": "api-token"}}}
          ],
          "envFrom": [
            {"configMapRef": {"name": "example-env"}}
          ],
          "resources": {
            "requests": {"cpu": "250m", "memory": "256Mi"},
            "limits": {"cpu": "1", "memory": "1Gi"}
          },
          "ports": [
            {"name": "http", "containerPort": 8080, "protocol": "TCP"}
          ],
          "readinessProbe": {
            "httpGet": {
              "path": "/healthz",
              "port": "http",
              "httpHeaders": [{"name": "X-Probe", "value": "ready"}]
            },
            "periodSeconds": 10
          },
          "livenessProbe": {
            "tcpSocket": {"port": 9000},
            "initialDelaySeconds": 5
          },
          "securityContext": {
            "runAsUser": 2000,
            "runAsGroup": 2000,
            "runAsNonRoot": true,
            "readOnlyRootFilesystem": true
          },
          "volumeMounts": [
            {"name": "config", "mountPath": "/etc/agent", "readOnly": true},
            {"name": "creds", "mountPath": "/etc/creds", "readOnly": true},
            {"name": "data", "mountPath": "/data"}
          ]
        }
      ]
    }
  }
}
